@namespace DFQuestionnaireV1.Components.Steps
@using DFQuestionnaireV1.Models
@using Microsoft.FluentUI.AspNetCore.Components 
@inject DFQuestionnaireV1.Models.QuestionnaireState State
@inject DFQuestionnaireV1.Repositories.IQuestionRepository Questions

<div class="intro">
   
    <h4><strong>Project Value</strong></h4>
    <hr style="width:650px; border-top:6px solid #336699;" />
    <div class="d-flex" style="gap:3rem;">

        <!-- Left column: Potential Consequences -->
        <div class="limited-col hanging-indent">


            <h7>
                <em>
                    1. If player interactions are not managed effectively, what might be the consequences?
                </em>

            </h7>
            <div class="d-flex flex-column" style="gap:.35rem;" role="group" aria-label="Potential consequences">
                @*@foreach (var pq in Questions.GetPotentialConsequences())
                { 
                                   
                     var id = $"pc-{pq.Id}";
                    <FluentCheckbox 
                                    @key=pq.Id
                                    Id="@id"
                                    Checked="@IsChecked(pq.Id)"
                                    CheckedChanged="(bool? v) => SetChecked(pq.Id, v)">
                        @pq.Text
                    </FluentCheckbox>
                    
                    var isChecked = State.PotentialConsequencesYes.Contains(pq.Id);
                    <FluentCheckbox @key="pq.Id"
                                    Id=@($"pc-{pq.Id}")
                                    Checked="isChecked"
                                    CheckedChanged="@( (bool? v) => ToggleConsequence(pq.Id, v == true) )">
                                    @pq.Text
                    </FluentCheckbox>

                }*@

                @foreach (var pq in Questions.GetPotentialConsequences())
                {
                    var id = $"pc-{pq.Id}";
                    <FluentCheckbox @key=pq.Id
                                    Id="@id"
                                    Value="@IsChecked(pq.Id)"
                                    ValueChanged="(bool v) => SetChecked(pq.Id, v)">
                        @pq.Text
                    </FluentCheckbox>
                }


            </div>
        </div>


        
        <!-- Right column: Inputs -->
        <div class="limited-col hanging-indent">

            <h7>
                <em>
                    2. Enter project value and amount risk.
                </em>

            </h7>
            <br />
            <br />

            
            <div class="d-flex flex-column" style="gap:1rem;">
         

                <div class="d-flex flex-column gap-1rem">

                    <!-- Project Value-->
                    <div class="d-flex align-items-center gap-05">
                        <label for="pv" class="mb-0">@Questions.ProjectValueText()</label>
                        <FluentNumberField Id="pv"
                                           TValue="int?"
                                           @bind-Value="State.ProjectValue"
                                           Min="0"
                                           Step="1"
                                           Style="width:6rem;" />
                    </div>

                     <!-- Management Radar-->
                     <div class="d-flex align-items-center gap-05">
                        <label for="mr" class="mb-0">@Questions.MgmtRadarText()</label>
                        <FluentNumberField Id="mr"
                                           TValue="int?"
                                           @bind-Value="State.MgmtRadar"
                                           Min="0"
                                           Step="1"
                                           Style="width:6rem;" />
                    </div>

                     <!-- interaction  Risk -->
                     <div class="d-flex align-items-center gap-05">
                        <label for="ir" class="mb-0">@Questions.InteractionRiskText()</label>
                        <FluentNumberField Id="ir"
                                           TValue="int?"
                                           @bind-Value="State.InteractionRisk"
                                           Min="0"
                                           Step="1"
                                           Style="width:6rem;" />
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>


@code {


    void Calculate()
    {

    }

    private void ToggleAnswer(int id, bool wasSelected)
    {
        if (wasSelected) State.PotentialConsequencesYes.Remove(id);
        else State.PotentialConsequencesYes.Add(id);
    }

    @*
    void ToggleAnswer(YesNoQuestion q, string val)
    {
        // if they clicked the already-selected option, clear it
        if (q.Answer == val)
            q.Answer = "";
        else
            q.Answer = val;
    }*@

    private void SetChecked(int id, bool? value)
    {
        if (value==true) State.PotentialConsequencesYes.Add(id);
        else State.PotentialConsequencesYes.Remove(id);

        //testing
        Console.WriteLine("[SetChecked] selected = " +
          string.Join(", ", State.PotentialConsequencesYes));
    }

    private bool IsChecked(int id)//testing
    {
        var has = State.PotentialConsequencesYes.Contains(id);
        Console.WriteLine($"[IsChecked] {id} -> {has}");
        return has;
    }

    protected override void OnInitialized()//testing 
    {
        // Log current state every time you enter the step
        Console.WriteLine("[StepIntro] selected (on enter) = " +
            string.Join(", ", State.PotentialConsequencesYes));
        Console.WriteLine("[StepIntro] IDs = " +
            string.Join(", ", Questions.GetPotentialConsequences().Select(q => q.Id)));
    }

    private void ToggleConsequence(int id, bool value)
    {
        if (value) State.PotentialConsequencesYes.Add(id);
        else State.PotentialConsequencesYes.Remove(id);
    }
    private Task ToggleConsequenceAsync(int id, bool value)
    {
        if (value) State.PotentialConsequencesYes.Add(id);
        else State.PotentialConsequencesYes.Remove(id);

        // debug: prove it wrote
        Console.WriteLine("[Toggle] selected = " + string.Join(",", State.PotentialConsequencesYes));
        return Task.CompletedTask;
    }

}