@namespace DFQuestionnaireV1.Components
@using Microsoft.AspNetCore.Components

<header class="wiz-head" aria-label="Wizard header">
    <div class="summary">
        <h1 class="title">@Title</h1>
        <div class="step-count">Part @Step of @StepCount</div>
    </div>

    @if (ShowProgress)
    {
        <div class="progress"
             role="progressbar"
             aria-valuemin="0"
             aria-valuemax="100"
             aria-valuenow="@Percent">
            <div class="bar" style="width:@($"{Percent}%")"></div>
            <span class="pct">@Percent%</span>
        </div>
    }
</header>

@code {
    [Parameter] public int Step { get; set; } = 1;
    [Parameter] public int StepCount { get; set; } = 1;
    [Parameter] public string Title { get; set; } = "Questionnaire";
    [Parameter] public bool ShowProgress { get; set; } = true;

    private int Percent => StepCount <= 1 ? 100 : (int)Math.Round((double)Step / StepCount * 100);
}

<style>
    .wiz-head {
        display: grid;
        gap: .5rem;
        margin: 0 0 1rem 0;
    }

    .summary {
        display: flex;
        align-items: baseline;
        gap: .75rem;
    }

    .title {
        font-size: 1.35rem;
        margin: 0;
    }

    .step-count {
        color: #555;
    }

    .progress {
        position: relative;
        height: .6rem;
        background: #eee;
        border-radius: .6rem;
        overflow: hidden;
    }

        .progress .bar {
            height: 100%;
            background: #333;
            border-radius: .6rem 0 0 .6rem;
        }

        .progress .pct {
            position: absolute;
            top: 100%;
            left: 0;
            margin-top: .25rem;
            font-size: .85rem;
            color: #444;
        }
</style>

