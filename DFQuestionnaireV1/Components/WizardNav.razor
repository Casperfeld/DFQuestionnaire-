@namespace DFQuestionnaireV1.Components
@using Microsoft.AspNetCore.Components

<div class="wizard-nav" role="navigation" aria-label="Wizard navigation">
    <button class="arrow prev"
            disabled="@(!CanPrev)"
            @onclick="OnPrev"
            aria-label="Previous step">
        ←
    </button>

    <div class="dots" role="tablist" aria-label="Steps">
        @for (int i = 1; i <= StepCount; i++)
        {
            <a class="dot @(i == Step ? "active" : null)"
               href="@($"/questionnaire/{i}")"
               role="tab"
               aria-selected="@(i == Step)">
            </a>
        }
    </div>

    <button class="arrow next"
            disabled="@(!CanNext)"
            @onclick="OnNext"
            aria-label="Next step">
        →
    </button>
</div>

@code {
    [Parameter] public int Step { get; set; }
    [Parameter] public int StepCount { get; set; }

    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrev { get; set; }

    // Optional: let the parent disable Next/Prev (e.g., for validation)
    [Parameter] public bool NextDisabled { get; set; }
    [Parameter] public bool PrevDisabled { get; set; }

    private bool CanPrev => Step > 1 && !PrevDisabled;
    private bool CanNext => Step < StepCount && !NextDisabled;
}

<style>
    .wizard-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1rem;
    }

    .arrow {
        font-size: 1.15rem;
        padding: .5rem 1rem;
        border: 1px solid #ccc;
        border-radius: .75rem;
        background: white;
        cursor: pointer;
    }

        .arrow[disabled] {
            opacity: .4;
            cursor: not-allowed;
        }

    .dots {
        display: flex;
        gap: .5rem;
    }

    .dot {
        width: .6rem;
        height: .6rem;
        border-radius: 50%;
        background: #d0d0d0;
        display: inline-block;
    }

        .dot.active {
            background: #333;
        }
</style>
