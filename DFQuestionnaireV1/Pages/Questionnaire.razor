<header class="topbar">
    <WizardNav Step="@Step"
               StepCount="@StepCount"
               OnPrev="() => Go(-1)"
               OnNext="() => Go(1)" />
</header>

<div class="page">
    <WizardHeader Step="@Step" StepCount="@StepCount" Title="Game Theory Questionnaire" />

    @switch (Step)
    {
        case 1:
            <StepIntro />
            ; break;
        case 2:
            <StepPart1 />
            ; break;
        case 3:
            <StepPart2 />
            ; break;
        case 4:
            <StepSummary />
            ; break;
    }
</div>

@code {
    [Parameter] public int? step { get; set; }

    // Update if you add/remove steps
    private const int StepCount = 4;
    private int Step => Math.Clamp(step ?? 1, 1, StepCount);

    protected override void OnParametersSet()
    {
        if (step is null || step < 1 || step > StepCount)
            Nav.NavigateTo("/questionnaire/1", replace: true);
    }

   @* // Gate the Next button (and right-arrow) by step validity
    private bool NextDisabled => Step switch
    {
        1 => false,                 // Intro
        2 => !State.IsPart1Valid(), // requires you added these helpers in QuestionnaireState
        3 => !State.IsPart2Valid(),
        _ => false
    };*@

    private void Go(int delta)
    {
        @*if (delta > 0 && NextDisabled) return; // block forward nav if invalid*@
        var next = Math.Clamp(Step + delta, 1, StepCount);
        if (next != Step) Nav.NavigateTo($"/questionnaire/{next}");
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowLeft") Go(-1);
        else if (e.Key == "ArrowRight") Go(1);
    }
}

<style>
    .wizard-shell {
        max-width: 860px;
        margin: 2rem auto;
        padding: 1rem;
        outline: none;
    }
</style>
